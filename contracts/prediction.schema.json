{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MBTA Stop Prediction Event",
  "type": "object",
  "required": [
    "event_id",
    "source",
    "schedule_id",
    "service_date",
    "route_id",
    "trip_id",
    "stop_id",
    "stop_sequence",
    "predicted_arrival",
    "predicted_departure",
    "ingested_at",
    "prediction_id",
    "vehicle_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "const": "MBTA"
    },
    "schedule_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "service_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "trip_id": {
      "type": "string",
      "minLength": 1
    },
    "stop_id": {
      "type": "string",
      "minLength": 1
    },
    "stop_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "predicted_arrival": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "predicted_departure": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "prediction_id": {
      "type": "string",
      "minLength": 1
    },
    "vehicle_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "predicted_arrival": {
          "type": "string"
        }
      }
    },
    {
      "properties": {
        "predicted_departure": {
          "type": "string"
        }
      }
    }
  ]
}
