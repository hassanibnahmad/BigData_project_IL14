{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "silver_vehicle_position",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source",
    "vehicle_id",
    "route_id",
    "trip_id",
    "latitude",
    "longitude",
    "vehicle_timestamp",
    "ingested_at",
    "kafka_topic",
    "kafka_partition",
    "kafka_offset",
    "kafka_timestamp"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "const": "MBTA"
    },
    "vehicle_id": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "trip_id": {
      "type": "string",
      "minLength": 1
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "vehicle_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "kafka_topic": {
      "type": "string",
      "minLength": 1
    },
    "kafka_partition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "kafka_offset": {
      "type": "integer",
      "minimum": 0
    },
    "kafka_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
