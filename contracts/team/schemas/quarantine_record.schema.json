{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "quarantine_record",
  "additionalProperties": false,
  "required": [
    "kafka_topic",
    "kafka_partition",
    "kafka_offset",
    "kafka_timestamp",
    "key_b64",
    "value_b64",
    "error_code"
  ],
  "properties": {
    "kafka_topic": {
      "type": "string",
      "minLength": 1
    },
    "kafka_partition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "kafka_offset": {
      "type": "integer",
      "minimum": 0
    },
    "kafka_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "key_b64": {
      "type": [
        "string",
        "null"
      ],
      "contentEncoding": "base64"
    },
    "value_b64": {
      "type": [
        "string",
        "null"
      ],
      "contentEncoding": "base64"
    },
    "error_code": {
      "enum": [
        "invalid_encoding",
        "invalid_json",
        "invalid_schema",
        "key_mismatch",
        "bad_event_id",
        "unmatched_schedule",
        "invalid_prediction_time",
        "invalid_simulated_time"
      ]
    }
  }
}
