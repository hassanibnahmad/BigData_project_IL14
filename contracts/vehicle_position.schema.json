
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MBTA Vehicle Position Event",
  "type": "object",
  "required": [
    "event_id",
    "source",
    "vehicle_id",
    "route_id",
    "trip_id",
    "latitude",
    "longitude",
    "vehicle_timestamp",
    "ingested_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "const": "MBTA"
    },
    "vehicle_id": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "trip_id": {
      "type": "string",
      "minLength": 1
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "vehicle_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
