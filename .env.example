.venv/
__pycache__/
.pytest_cache/
.env
*.pyc
*.log

data/gtfs/*
!data/gtfs/.gitkeep
data/samples/*
!data/samples/.gitkeep

output/

MBTA_API_KEY=
MBTA_ROUTES=1,66,77
MBTA_API_URL=https://api-v3.mbta.com

# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=positions_vehicules
MBTA_POLL_INTERVAL=20

# Kafka Consumer
KAFKA_CONSUMER_GROUP=il14-python-consumer       #Identifies our Python consumer group
KAFKA_AUTO_OFFSET_RESET=earliest                #Starts from earliest available messages when no committed offset exists

# Stop-time ingestion (seconds)
MBTA_SCHEDULE_REFRESH_INTERVAL=21600
